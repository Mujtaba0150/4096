{
    "editor.formatOnType": false,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.minimap.enabled": false,
    "files.autoSave": "afterDelay",
    "C_Cpp.formatting": "vcFormat",
    "C_Cpp.vcFormat": {
        "indent": {
            "caseLabels": true,
            "accessSpecifiers": false
        },
        "newLine": {
            "beforeOpenBrace": {
                "block": "sameLine",
                "function": "sameLine",
                "lambda": "sameLine",
                "namespace": "sameLine",
                "type": "sameLine"
            },
            "beforeWhileInDoWhile": true,
            "beforeElse": true
        },
        "space": {
            "aroundAssignmentOperator": "insert",
            "afterComma": true,
            "beforeBlockOpenBrace": true,
            "beforeFunctionOpenParenthesis": "remove",
            "beforeOpenBrace": false,
            "removeBeforeSemicolon": true,
            "afterKeywordsInControlFlowStatements": false,
            "betweenEmptyBraces": false,
            "betweenEmptySquareBrackets": false,
            "betweenEmptyParameterListParentheses": false,
            "withinSquareBrackets": false,
            "withinCastParentheses": false,
            "withinInitializerListBraces": false,
            "withinLambdaBrackets": false,
            "withinParameterListParentheses": false
        }
    },
    "better-comments.tags": [
        {
            "tag": "!",
            "color": "#FF2D00",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "?",
            "color": "#3498DB",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "//",
            "color": "#474747",
            "strikethrough": true,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "todo",
            "color": "#FF8C00",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "*",
            "color": "#98C379",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        }
    ],
    "inline-bookmarks.default.words.red": "//!",
}